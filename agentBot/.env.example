# ============ 飞书应用凭证 ============
# 已集中到 ~/.config/agentConfig/feishu.env（Docker 由 compose env_file 注入；本地开发 source 该文件）
# 仅本地临时调试时可直接取消注释填写：
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# 默认通知群（可选，事件找不到 chat 时兜底）
FEISHU_DEFAULT_CHAT_ID=

# 群通知 Webhook（可选，用于异常/重试通知）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ============ OpenCode 服务 ============
OPENCODE_BASE_URL=http://127.0.0.1:4096
# 默认模型提供方
OPENCODE_PROVIDER=CodingPlan
# 默认 Agent key（见 config/agents.json）
OPENCODE_DEFAULT_AGENT=main

# ============ 消息处理 ============
# 消息去重 TTL（毫秒）
FEISHU_MESSAGE_ID_TTL=3600000
# 消息过期时间（毫秒），超龄消息直接丢弃
FEISHU_MESSAGE_EXPIRY_TIME=120000
# 处理标记清理延迟（毫秒）
FEISHU_PROCESSING_TIMEOUT=5000

# ============ 日志 ============
FEISHU_LOG_LEVEL=info
FEISHU_DEBUG=false

# ============ OpenCode 探活与重连 ============
# 探活间隔（毫秒），默认 30000
# AGENTBOT_HEALTH_INTERVAL_MS=30000
# 连续失败阈值，达到后标记不可用并等待恢复，默认 2
# AGENTBOT_HEALTH_FAILURES=2
