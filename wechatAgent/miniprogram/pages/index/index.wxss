.page {
    min-height: 100vh;
    padding: 32rpx 32rpx 60rpx;
}

/* 顶部 */
.header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 40rpx;
    padding-top: 8rpx;
}

.title {
    font-size: 52rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.subtitle {
    margin-top: 8rpx;
    font-size: 26rpx;
    color: var(--text-faint);
}

.settings-btn {
    width: 72rpx;
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    color: var(--text-dim);
    background: var(--bg-elevated);
    border-radius: 50%;
    border: 1rpx solid var(--border);
}

/* 新建按钮 */
.new-btn {
    margin-bottom: 36rpx;
}

.plus {
    margin-right: 10rpx;
    font-size: 34rpx;
}

/* 错误 */
.error-box {
    margin-bottom: 24rpx;
    padding: 24rpx;
    border-radius: 16rpx;
    background: rgba(255, 107, 107, 0.1);
    border: 1rpx solid rgba(255, 107, 107, 0.3);
    color: var(--error);
    font-size: 26rpx;
}

/* 列表 */
.list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.card {
    padding: 28rpx;
    border-radius: 20rpx;
    background: var(--bg-elevated);
    border: 1rpx solid var(--border);
}

.card:active {
    background: var(--bg-input);
}

.card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20rpx;
}

.card-title {
    flex: 1;
    font-size: 32rpx;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.card-time {
    flex-shrink: 0;
    font-size: 24rpx;
    color: var(--text-faint);
}

.card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14rpx;
}

.card-preview {
    font-size: 25rpx;
    color: var(--text-faint);
}

.card-preview.busy {
    color: var(--success);
}

.card-engine {
    font-size: 22rpx;
    color: var(--text-faint);
    padding: 4rpx 14rpx;
    border-radius: 20rpx;
    background: var(--bg-input);
}

.tip {
    margin-top: 28rpx;
    text-align: center;
    font-size: 24rpx;
    color: var(--text-faint);
}